{
  "id": "cpp-bugfix-off-by-one",
  "title": "범위 합계 경계값 버그 수정",
  "language": "cpp",
  "prompt": "sum_range(1, 3)이 6이어야 하는데 5가 나온다. range.cpp의 버그를 찾아 고쳐라. test.cpp는 수정하지 마라.",
  "judge": [
    {
      "name": "build",
      "cmd": "{cxx} -std=c++17 -Wall -o check{exe} range.cpp test.cpp"
    },
    {
      "name": "test",
      "cmd": ".{sep}check{exe}"
    }
  ],
  "expect": [
    {
      "file": "range.cpp",
      "regex": "sum_range"
    }
  ],
  "budget": {
    "timeoutSec": 300,
    "maxTurns": 20
  }
}
